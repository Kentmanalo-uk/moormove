# MoorMove's own database (never E-MOORM's).
DATABASE_URL="mysql://root:@localhost:3306/moormove_db"

PORT=4000
NODE_ENV=development

# A long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Where the MoorMove web app runs (allowed to call this API).
# Production: https://moormove.emoorm.shop
WEB_ORIGIN=http://localhost:5174

# E-MOORM's API: its public towns, and where updates about E-MOORM orders are
# sent. Production: https://emoorm.shop/api
EMOORM_API_URL=http://localhost:3000/api

# The secret shared with E-MOORM (E-MOORM's MOORMOVE_SECRET must be the same
# value), at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Empty: E-MOORM can't book riders and no updates are sent.
PARTNER_SECRET=

# Serve the built web app (web/dist) from this server, and run
# `prisma migrate deploy` after starting. Both are on when NODE_ENV=production.
# SERVE_WEB=1
# MIGRATE_ON_START=1

# Riders' documents and proof photos. On Hostinger: a folder OUTSIDE the app
# (a redeploy replaces the app folder), e.g. /home/<user>/moormove-data/uploads.
# Default: backend/uploads
UPLOAD_DIR=

# Fares are by the km by road from pickup to drop-off, asked of an OSRM route
# service. Default: OSRM's public demo server (https://router.project-osrm.org),
# fine for low volume; swap it for a self-hosted or paid OSRM-compatible URL as
# deliveries grow. "off": never asked; every distance is an estimate (straight
# line × the road factor in Settings), as it is whenever the service is down
# or takes over 4 seconds.
# ROUTING_URL=https://router.project-osrm.org
